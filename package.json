{
  "name": "dependencies-action",
  "description": "A GitHub Action that enforces PR dependencies",
  "version": "1.4.3",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "ncc build index.js -o dist --license licenses.txt",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "moduleNameMapper": {
      "^@actions/github$": "<rootDir>/__mocks__/@actions/github.js",
      "^@actions/core$": "<rootDir>/__mocks__/@actions/core.js"
    }
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "jest": "^29.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/dependencies-action.git"
  },
  "keywords": [],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/dependencies-action/issues"
  },
  "homepage": "https://github.com/step-security/dependencies-action#readme"
}
